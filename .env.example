QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
KIN_STORE=.kin/store.json
PORT=8000

# Taste source: "qloo" or "wikidata" (default: qloo if QLOO_API_KEY is set)
KIN_TASTE_SOURCE=
# Family push alerts via ntfy; leave topic empty to disable
KIN_NTFY_TOPIC=
KIN_NTFY_SERVER=https://ntfy.sh

# Agent model: "ollama" (local, default), "openai" (any OpenAI-compatible host
# serving open models, e.g. Groq or OpenRouter) or "bedrock"
KIN_MODEL_PROVIDER=ollama
KIN_MODEL_ID=llama3.2
OLLAMA_HOST=http://localhost:11434
KIN_OPENAI_BASE_URL=
KIN_OPENAI_API_KEY=
AWS_REGION=us-west-2
# Use a running MCP server instead of starting one over stdio
KIN_MCP_URL=
# DynamoDB table; leave empty to use the local JSON store (KIN_STORE)
KIN_TABLE=
